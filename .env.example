APP_NAME=Safaribook
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://safaribook.africa

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Shared ShuleSoft PostgreSQL database. This site only touches admin.clients
# (project_id 3 = Safaribook) and reads constant.refer_countries.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=shulesoft2024
DB_USERNAME=
DB_PASSWORD=

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync

# Where the owner continues after verifying: https://{username}.<TENANT_DOMAIN>
TENANT_DOMAIN=safaribook.africa

# WhatsApp: Meta Cloud API first (approved OTP template), notification API as fallback
META_WHATSAPP_ENABLED=false
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_OTP_TEMPLATE_NAME=otp_verification
NOTIFICATION_API_URL=https://notifications.shulesoft.africa/api
NOTIFICATION_API_KEY=
NOTIFICATION_API_SCHEMA=
# WhatsApp number that receives "new sign-up" alerts
TEAM_WHATSAPP=

# Email (OTP copy)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Safaribook"
